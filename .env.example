# Clés d'API des jeux : "<id du jeu>:<clé>" séparés par des virgules.
# Une clé = un jeu, elle ne donne le droit d'écrire que dans les classements de CE jeu.
# Générer une clé : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GAMEBOARD_KEYS=car_race:remplacer_par_une_cle_hex_de_64_caracteres
PORT=3000
HOST=0.0.0.0
# dossier des classements (en ligne : un volume)
DATA_DIR=./data
